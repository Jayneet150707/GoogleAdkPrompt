# Paisalo Loan Chatbot - Environment Variables
# Copy this file to .env and update values as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Google Actions Configuration
GOOGLE_PROJECT_ID=paisalo-loan-assistant
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Database Configuration (if needed for session persistence)
# DATABASE_URL=sqlite:///paisalo_sessions.db
# REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=your-secret-key-here
SESSION_TIMEOUT=3600

# Business Rules (Override defaults if needed)
# MIN_AGE=21
# MAX_AGE=57
# MIN_CREDIT_SCORE=18
# MAX_CREDIT_SCORE=650
# MIN_LOAN_AMOUNT=50000
# MAX_LOAN_AMOUNT=100000

# External API Configuration (if integrating with Paisalo systems)
# PAISALO_API_URL=https://api.paisalo.in
# PAISALO_API_KEY=your-api-key-here

# Monitoring and Analytics
# SENTRY_DSN=your-sentry-dsn-here
# GOOGLE_ANALYTICS_ID=your-ga-id-here

# Production Settings
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=30
# GUNICORN_BIND=0.0.0.0:3000

